--- !u!114 &5489798399848938347
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1647792476521083640}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd018de82f0b31148b57f5c7ecedb9f3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  advancedRichTextContainers:
  - textKey: Start
    advancedRichTexts:
      richTextObjects:
      - text: GO, GO, GO!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
      - text: We'll get them before help arrives!
        newLine: 1
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: Withstand
    advancedRichTexts:
      richTextObjects:
      - text: 'Hold on a little longer!  '
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
      - text: All the zombies are about to die!
        newLine: 1
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: Resist
    advancedRichTexts:
      richTextObjects:
      - text: Resist, it will be over soon!
        newLine: 0
        textColor: {r: 0.06666667, g: 0.0627451, b: 0.0627451, a: 1}
        textType: 0
        lineType: 0
  - textKey: Complete
    advancedRichTexts:
      richTextObjects:
      - text: THIS IS IT!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
      - text: Our region is safer now, keep fighting!
        newLine: 1
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: Convoy
    advancedRichTexts:
      richTextObjects:
      - text: THE TRUCK IS COMING!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
      - text: Let's protect the truck!
        newLine: 1
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: Landing
    advancedRichTexts:
      richTextObjects:
      - text: LANDING SUCCESSFUL!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
      - text: We'll take it from here, you can go back to your headquarters!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: TooManyZombies
    advancedRichTexts:
      richTextObjects:
      - text: There are too many of them!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: Homedefence
    advancedRichTexts:
      richTextObjects:
      - text: I'm not running away, this is my home!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: Motivation_01
    advancedRichTexts:
      richTextObjects:
      - text: If we get out of here, we'll tell this story like heroes!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  - textKey: Motivation_02
    advancedRichTexts:
      richTextObjects:
      - text: If you're not dead, keep fighting!
        newLine: 0
        textColor: {r: 0, g: 0, b: 0, a: 1}
        textType: 0
        lineType: 0
  text: {fileID: 2015886486842711677}
  typingSpeedMs: 50
  showTime: 3
  maxScale: 0.55
  speechBubbleTransform: {fileID: 1132752598014865731}
  lookAtCamera: 1
